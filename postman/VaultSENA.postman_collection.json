{
  "info": {
    "name": "VaultSENA API",
    "description": "Colección de pruebas para la evidencia SENA - Gestor de contraseñas",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000/api" },
    { "key": "token", "value": "" },
    { "key": "servicio_id", "value": "" }
  ],
  "item": [
    {
      "name": "1. Health check",
      "request": { "method": "GET", "url": "{{base_url}}/health" }
    },
    {
      "name": "2. Auth - Registro",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/auth/registro",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Juan Perez\",\n  \"correo\": \"juan@correo.com\",\n  \"password\": \"1234abcd\"\n}"
        }
      }
    },
    {
      "name": "3. Auth - Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const datos = pm.response.json();",
              "if (datos.token) { pm.collectionVariables.set('token', datos.token); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo\": \"juan@correo.com\",\n  \"password\": \"1234abcd\"\n}"
        }
      }
    },
    {
      "name": "4. Usuarios - Ver perfil",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{base_url}}/usuarios/perfil"
      }
    },
    {
      "name": "5. Usuarios - Actualizar perfil",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{base_url}}/usuarios/perfil",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Juan Perez Actualizado\",\n  \"correo\": \"juan@correo.com\"\n}"
        }
      }
    },
    {
      "name": "6. Categorias - Listar",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{base_url}}/categorias"
      }
    },
    {
      "name": "7. Servicios - Crear (PIN)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const datos = pm.response.json();",
              "if (datos.id) { pm.collectionVariables.set('servicio_id', datos.id); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{base_url}}/servicios",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"categoria_id\": 1,\n  \"nombre_servicio\": \"Netflix\",\n  \"usuario_servicio\": \"juanp\",\n  \"correo_servicio\": \"juan@correo.com\",\n  \"password_servicio\": \"miPassNetflix123\",\n  \"url\": \"https://netflix.com\",\n  \"notas\": \"Cuenta familiar\",\n  \"metodo_desbloqueo\": \"pin\",\n  \"pin\": \"1234\"\n}"
        }
      }
    },
    {
      "name": "8. Servicios - Listar",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{base_url}}/servicios"
      }
    },
    {
      "name": "9. Servicios - Obtener uno",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{base_url}}/servicios/{{servicio_id}}"
      }
    },
    {
      "name": "10. Servicios - Actualizar",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{base_url}}/servicios/{{servicio_id}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"notas\": \"Cuenta familiar - actualizada\"\n}"
        }
      }
    },
    {
      "name": "11. Servicios - Desbloquear (ver password)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{base_url}}/servicios/{{servicio_id}}/desbloquear",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"pin\": \"1234\"\n}"
        }
      }
    },
    {
      "name": "12. Servicios - Eliminar",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{base_url}}/servicios/{{servicio_id}}"
      }
    },
    {
      "name": "13. Usuarios - Eliminar cuenta",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{base_url}}/usuarios/perfil"
      }
    }
  ]
}
