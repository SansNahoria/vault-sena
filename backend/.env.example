# ============================================
# Copia este archivo como ".env" y llena tus datos reales
# NUNCA subas el archivo ".env" real a GitHub
# ============================================

# Puerto donde correrá el servidor
PORT=3000

# --- MySQL ---
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=tu_password_de_mysql
MYSQL_DATABASE=vault_sena

# --- MongoDB ---
# Si usas MongoDB local:
MONGO_URI=mongodb://localhost:27017/vault_sena_logs
# Si usas MongoDB Atlas (nube), reemplaza por tu cadena de conexión

# --- JWT ---
JWT_SECRET=una_clave_secreta_larga_y_dificil_de_adivinar
JWT_EXPIRES_IN=2h

# --- Cifrado de contraseñas de servicios (reversible) ---
# Debe tener EXACTAMENTE 32 caracteres (256 bits) para AES-256
ENCRYPTION_KEY=12345678901234567890123456789012

# --- CORS (producción) ---
# URL donde queda publicado el frontend en Vercel.
# Puedes poner varias separadas por coma si tienes más de un dominio.
FRONTEND_URL=https://tu-proyecto.vercel.app

